@am__fastdepCXX_TRUE@	$(AM_V_CXX)$(CXX) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(gnuclad_CPPFLAGS) $(CPPFLAGS) $(AM_CXXFLAGS) $(CXXFLAGS) -MT gnuclad-gnuclad-portability.o -MD -MP -MF $(DEPDIR)/gnuclad-gnuclad-portability.Tpo -c -o gnuclad-gnuclad-portability.o `test -f 'gnuclad-portability.cpp' || echo '$(srcdir)/'`gnuclad-portability.cpp
@am__fastdepCXX_TRUE@	$(AM_V_at)$(am__mv) $(DEPDIR)/gnuclad-gnuclad-portability.Tpo $(DEPDIR)/gnuclad-gnuclad-portability.Po
